<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The bridge proof, as an Instrumentation so that it can be run with `am instrument`.

      It is declared here, in the debug source set, so it is in the debug APK and in no other: the
      proof is something to run deliberately, not something the shipping app does at launch.

      android:targetPackage must be the app's own package, and the app's id is
      fork.MaxrregMustermann.TheFileManager. The target of the instrumentation, `am instrument -w
      fork.MaxrregMustermann.TheFileManager.test/...`, is the instrumentation's own component name, which is
      `<package>.<class>`.
      -->
    <instrumentation
        android:name="fork.MaxrregMustermann.TheFileManager.bridge.BridgeInstrumentation"
        android:targetPackage="fork.MaxrregMustermann.TheFileManager" />

</manifest>